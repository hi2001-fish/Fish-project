#!/usr/bin/env python3

import serial
import time
import pygame
import csv
from datetime import datetime
from picamera2 import Picamera2
from fish.setup import setup_picture_folder

PHOTO_PATH = setup_picture_folder()
picam2 = Picamera2()
picam2.start_preview(None)

ser = None

def send_command(cmd: str):
    ser.write(f"{cmd}\n".encode('utf-8'))
    print(f"Sent: {cmd}")

def take_photo(photo_folder: str = PHOTO_PATH):
    current_timestamp = datetime.now().strftime("%d-%m-%Y-%H-%M-%S")
    image_file = str(photo_folder / f"{current_timestamp}.jpg")
    picam2.start_and_capture_file(image_file)
    print(f"Photo saved: {image_file}")

# Fish tail state
last_turn_command = None
is_fish_moving = False
current_speed = "SLOW"
speed_cycle = ["SLOW", "MEDIUM", "FAST"]

# Stepper state
last_stepper_direction = None   # "ASCEND" or "DESCEND"
ascend_press_time = 0

def cycle_speed():
    global current_speed, is_fish_moving
    current_index = speed_cycle.index(current_speed)
    current_speed = speed_cycle[(current_index + 1) % 3]
    print(f"Speed set to: {current_speed}")
    
    if is_fish_moving:
        send_command(current_speed)

def process_joystick(joystick):
    """Fish tail control"""
    global last_turn_command, is_fish_moving
    
    x_axis = joystick.get_axis(0)
    y_axis = joystick.get_axis(1)
    
    DEADZONE = 0.2
    
    # STOP swimming
    if y_axis > DEADZONE:
        if is_fish_moving:
            send_command("STOP")
            is_fish_moving = False
        return
    
    # START swimming
    if y_axis < -DEADZONE:
        if not is_fish_moving:
            send_command(current_speed)
            is_fish_moving = True
    
    # TURNING
    if is_fish_moving:
        if x_axis < -DEADZONE:
            turn_command = "LEFT"
        elif x_axis > DEADZONE:
            turn_command = "RIGHT"
        else:
            turn_command = "CENTER"
        
        if turn_command != last_turn_command:
            send_command(turn_command)
            last_turn_command = turn_command

def main():
    global ser, last_stepper_direction, ascend_press_time
    
    ser = serial.Serial('/dev/ttyACM0', 9600, timeout=1)
    ser.reset_input_buffer()
    
    pygame.init()
    pygame.joystick.init()
    
    joystick = None

    # Button hold states
    button_speed_held = False
    button_photo_held = False

    # Stepper button hold states
    stepper_buttons_held = {
        "DESCEND": False,
        "ASCEND": False,
        "STOP": False
    }
    
    if pygame.joystick.get_count() > 0:
        joystick = pygame.joystick.Joystick(0)
        joystick.init()
        print(f"Controller: {joystick.get_name()}")
    
    print("Ready!")
    print("Fish: Forward=Swim | Back=Stop | L/R=Turn")
    print("Nintendo Mapping:")
    print("  X = ASCEND / FAILSAFE")
    print("  B = DESCEND")
    print("  A = STOP")
    print("  Y = CYCLE SPEEDS")
    print("  ZL = TAKE PHOTO")
    
    while True:
        for event in pygame.event.get():
            if event.type == pygame.JOYDEVICEADDED:
                joystick = pygame.joystick.Joystick(event.device_index)
                joystick.init()
            elif event.type == pygame.JOYDEVICEREMOVED:
                joystick = None
        
        if joystick is not None:
            process_joystick(joystick)

            # -----------------------------
            # Nintendo button mapping
            # -----------------------------
            Y_btn  = joystick.get_button(0)   # cycle speeds
            B_btn  = joystick.get_button(1)   # DESCEND
            A_btn  = joystick.get_button(2)   # STOP
            X_btn  = joystick.get_button(3)   # ASCEND / FAILSAFE
            ZL_btn = joystick.get_button(6)   # take photo

            # --- SPEED CYCLING (Y button) ---
            if Y_btn and not button_speed_held:
                cycle_speed()
                button_speed_held = True
            elif not Y_btn:
                button_speed_held = False

            # --- TAKE PHOTO (ZL button) ---
            if ZL_btn and not button_photo_held:
                take_photo()
                button_photo_held = True
            elif not ZL_btn:
                button_photo_held = False

            # --- DESCEND (B button) ---
            if B_btn and not stepper_buttons_held["DESCEND"]:
                send_command("DESCEND")
                last_stepper_direction = "DESCEND"
                stepper_buttons_held["DESCEND"] = True
            elif not B_btn:
                stepper_buttons_held["DESCEND"] = False

            # --- ASCEND / FAILSAFE (X button) ---
            if X_btn and not stepper_buttons_held["ASCEND"]:
                ascend_press_time = time.time()
                stepper_buttons_held["ASCEND"] = True

            elif not X_btn and stepper_buttons_held["ASCEND"]:
                press_duration = time.time() - ascend_press_time

                if press_duration >= 3.0:
                    send_command("FAILSAFE")
                else:
                    send_command("ASCEND")
                    last_stepper_direction = "ASCEND"

                stepper_buttons_held["ASCEND"] = False

            # --- STOP (A button) ---
            if A_btn and not stepper_buttons_held["STOP"]:
                if last_stepper_direction == "DESCEND":
                    send_command("STOP_AFTER_DESCEND")
                else:
                    send_command("STOP_AFTER_ASCEND")
                stepper_buttons_held["STOP"] = True
            elif not A_btn:
                stepper_buttons_held["STOP"] = False

        # Temperature logging
        if ser.in_waiting > 0:
            temp = ser.readline().decode('latin-1').rstrip()
            with open("tempread.csv", "a") as f:
                f.write(datetime.now().strftime('%d/%m/%Y, %H:%M:%S') + "," + temp + "\n")
            print(temp)
        
        time.sleep(0.05)

if __name__ == '__main__':
    main()
