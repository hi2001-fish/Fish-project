#include <OneWire.h>
#include <DallasTemperature.h>
#include <AccelStepper.h>

// ----------------------
// OneWire / Temperature
// ----------------------
#define ONE_WIRE_BUS 2
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);
const unsigned long tempInterval = 10000; // 10 seconds
unsigned long lastTempMillis = 0;

// ----------------------
// Pin Definitions
// ----------------------
#define dirPin 8 // pin 8 yellow
#define stepPin 9 // pin 9 orange
#define homeSwitchPin 4
#define descendButtonPin 3
#define ascendButtonPin 2
#define stopButtonPin 6

// ----------------------
// Stepper Setup
// ----------------------
AccelStepper stepper(AccelStepper::DRIVER, stepPin, dirPin);

// ----------------------
// Global Variables
// ----------------------
bool isHomed = false;
const int equilibriumPosition = -214;

unsigned long debounceDelay = 50;

unsigned long lastDescendTime = 0;
unsigned long lastAscendTime = 0;
unsigned long lastStopTime = 0;

bool lastDescendState = HIGH;
bool lastAscendState = HIGH;
bool lastStopState = HIGH;

unsigned long ascendButtonPressTime = 0;
const unsigned long longPressDuration = 3000;

bool lastButtonWasDescend = false;
bool lastButtonWasAscend = false;

// ==========================================================
// PRINT CURRENT POSITION
// ==========================================================
void printCurrentPosition() {
  Serial.print("Current Position: ");
  Serial.print(stepper.currentPosition());
  Serial.println(" steps");
}

// ==========================================================
// SETUP
// ==========================================================
void setup() {
  Serial.begin(9600);

  // Stepper config
  stepper.setMaxSpeed(1000);
  stepper.setAcceleration(500);

  // Pins
  pinMode(homeSwitchPin, INPUT_PULLUP);
  pinMode(descendButtonPin, INPUT_PULLUP);
  pinMode(ascendButtonPin, INPUT_PULLUP);
  pinMode(stopButtonPin, INPUT_PULLUP);

  // Temperature sensor
  sensors.begin();

  // Home the stepper
  homeStepper();

  // initial temperature read time
  lastTempMillis = millis();
}

// ==========================================================
// MAIN LOOP
// ==========================================================
void loop() {
  if (!isHomed) return;

  // Handle buttons (these call blocking move routines)
  handleDescendButton();
  handleAscendButton();
  handleStopButton();

  // Periodic temperature read (non-blocking)
  unsigned long now = millis();
  if (now - lastTempMillis >= tempInterval) {
    lastTempMillis = now;
    readAndPrintTemperature();
  }
}

// ==========================================================
// HOMING FUNCTION
// ==========================================================
void homeStepper() {
  Serial.println("Homing stepper motor...");

  stepper.setSpeed(500);   // move toward switch

  while (digitalRead(homeSwitchPin) == HIGH) {
    stepper.runSpeed();
  }

  // Stop immediately when switch is hit
  stepper.stop();
  delay(100);  // small settle delay

  stepper.setCurrentPosition(0);  // THIS position is zero
  isHomed = true;

  Serial.println("Homing complete.");
  printCurrentPosition();   // should print 0
}

// ==========================================================
// DESCEND BUTTON
// ==========================================================
void handleDescendButton() {
  bool currentState = digitalRead(descendButtonPin);
  unsigned long currentTime = millis();

  if (currentState != lastDescendState &&
      currentTime - lastDescendTime > debounceDelay) {

    lastDescendTime = currentTime;

    if (currentState == LOW) {
      Serial.println("Descend pressed");

      lastButtonWasDescend = true;
      lastButtonWasAscend = false;

      descendStepper();
    }
  }

  lastDescendState = currentState;
}

// ==========================================================
// ASCEND BUTTON
// ==========================================================
void handleAscendButton() {
  bool currentState = digitalRead(ascendButtonPin);
  unsigned long currentTime = millis();

  if (currentState != lastAscendState &&
      currentTime - lastAscendTime > debounceDelay) {

    lastAscendTime = currentTime;

    if (currentState == LOW) {
      ascendButtonPressTime = currentTime;
    }

    if (currentState == HIGH) {
      if (currentTime - ascendButtonPressTime >= longPressDuration) {
        Serial.println("Fail-safe triggered");
        failSafeToZero();
      } else {
        Serial.println("Ascend pressed");

        lastButtonWasAscend = true;
        lastButtonWasDescend = false;

        ascendStepper();
      }
    }
  }

  lastAscendState = currentState;
}

// ==========================================================
// STOP BUTTON
// ==========================================================
void handleStopButton() {
  bool currentState = digitalRead(stopButtonPin);
  unsigned long currentTime = millis();

  if (currentState != lastStopState &&
      currentTime - lastStopTime > debounceDelay) {

    lastStopTime = currentTime;

    if (currentState == LOW) {
      if (lastButtonWasDescend) {
        stopAfterDescend();
      }
      else if (lastButtonWasAscend) {
        stopAfterAscend();
      }
    }
  }

  lastStopState = currentState;
}

// ==========================================================
// DESCEND FUNCTION
// ==========================================================
void descendStepper() {
  Serial.println("Descending...");

  stepper.moveTo(-600);
  while (stepper.distanceToGo() != 0) {
    stepper.run();
  }

  delay(500);

  stepper.moveTo(equilibriumPosition);
  while (stepper.distanceToGo() != 0) {
    stepper.run();
  }

  Serial.println("Descend complete.");
  printCurrentPosition();
}

// ==========================================================
// ASCEND FUNCTION
// ==========================================================
void ascendStepper() {
  Serial.println("Ascending...");

  stepper.moveTo(0);
  while (stepper.distanceToGo() != 0) {
    stepper.run();
  }

  delay(500);

  stepper.moveTo(equilibriumPosition);
  while (stepper.distanceToGo() != 0) {
    stepper.run();
  }

  Serial.println("Ascend complete.");
  printCurrentPosition();
}

// ==========================================================
// FAIL-SAFE FUNCTION
// ==========================================================
void failSafeToZero() {
  Serial.println("Moving to zero (fail-safe)...");

  stepper.moveTo(0);
  while (stepper.distanceToGo() != 0) {
    stepper.run();
  }

  Serial.println("Holding at zero.");
  printCurrentPosition();
}

// ==========================================================
// STOP AFTER DESCEND
// ==========================================================
void stopAfterDescend() {
  Serial.println("Stop after descend...");

  stepper.moveTo(100);
  while (stepper.distanceToGo() != 0) {
    stepper.run();
  }

  delay(500);

  stepper.moveTo(equilibriumPosition);
  while (stepper.distanceToGo() != 0) {
    stepper.run();
  }

  Serial.println("Stop after descend complete.");
  printCurrentPosition();
}

// ==========================================================
// STOP AFTER ASCEND
// ==========================================================
void stopAfterAscend() {
  Serial.println("Stop after ascend...");

  stepper.moveTo(-300);
  while (stepper.distanceToGo() != 0) {
    stepper.run();
  }

  delay(500);

  stepper.moveTo(equilibriumPosition);
  while (stepper.distanceToGo() != 0) {
    stepper.run();
  }

  Serial.println("Stop after ascend complete.");
  printCurrentPosition();
}

// ==========================================================
// TEMPERATURE READ
// ==========================================================
void readAndPrintTemperature() {
  sensors.requestTemperatures(); // request from all sensors
  float tempC = sensors.getTempCByIndex(0);

  if (tempC == DEVICE_DISCONNECTED_C) {
    Serial.println("Temp sensor error: device disconnected.");
    return;
  }

  float tempF = (tempC * 9.0) / 5.0 + 32.0;

  Serial.print("Temperature: ");
  Serial.print(tempC, 2);
  Serial.print(" °C  |  ");
  Serial.print(tempF, 2);
  Serial.println(" °F");
}
