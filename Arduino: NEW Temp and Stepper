#include <OneWire.h>
#include <DallasTemperature.h>
#include <AccelStepper.h>
#include <Servo.h>

// ----------------------
// OneWire / Temperature
// ----------------------
#define ONE_WIRE_BUS 2
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);
const unsigned long tempInterval = 10000;
unsigned long lastTempMillis = 0;

// ----------------------
// Stepper Pins
// ----------------------
#define dirPin 8
#define stepPin 7 //orange
#define homeSwitchPin 4

// ----------------------
// Servo
// ----------------------
#define SERVO_PIN 9
Servo cameraServo;

int servoTarget = 90;       // default center
int servoCurrent = 90;
int servoSpeed = 2;         // default speed (degrees per update)

// ----------------------
// Stepper Setup
// ----------------------
AccelStepper stepper(AccelStepper::DRIVER, stepPin, dirPin);

bool isHomed = false;
const int equilibriumPosition = -214;

// ==========================================================
// PRINT CURRENT POSITION
// ==========================================================
void printCurrentPosition() {
  Serial.print("Current Position: ");
  Serial.print(stepper.currentPosition());
  Serial.println(" steps");
}

// ==========================================================
// SETUP
// ==========================================================
void setup() {
  Serial.begin(9600);

  // Stepper config
  stepper.setMaxSpeed(1000);
  stepper.setAcceleration(500);

  pinMode(homeSwitchPin, INPUT_PULLUP);

  // Temperature
  sensors.begin();

  // Servo
  cameraServo.attach(SERVO_PIN);
  cameraServo.write(servoCurrent);

  // Home stepper
  homeStepper();

  lastTempMillis = millis();
}

// ==========================================================
// MAIN LOOP
// ==========================================================
void loop() {
  if (!isHomed) return;

  // Stepper always runs
  stepper.run();

  // Smooth servo movement
  updateServo();

  // Serial command handling
  handleSerialCommands();

  // Temperature reading
  unsigned long now = millis();
  if (now - lastTempMillis >= tempInterval) {
    lastTempMillis = now;
    readAndPrintTemperature();
  }
}

// ==========================================================
// SERIAL COMMAND HANDLER
// ==========================================================
void handleSerialCommands() {
  if (!Serial.available()) return;

  String cmd = Serial.readStringUntil('\n');
  cmd.trim();

  // ---- STEPPER COMMANDS ----
  if (cmd == "ASCEND") {
    ascendStepper();
  }
  else if (cmd == "DESCEND") {
    descendStepper();
  }
  else if (cmd == "STOP") {
    stopAfterDescend(); // or stopAfterAscend depending on your logic
  }

  // ---- SERVO POSITION COMMANDS ----
  else if (cmd == "LEFT") {
    servoTarget = 0;
  }
  else if (cmd == "CENTER") {
    servoTarget = 90;
  }
  else if (cmd == "RIGHT") {
    servoTarget = 180;
  }

  // ---- SERVO SPEED COMMANDS ----
  else if (cmd == "SLOW") {
    servoSpeed = 1;
  }
  else if (cmd == "MEDIUM") {
    servoSpeed = 3;
  }
  else if (cmd == "FAST") {
    servoSpeed = 7;
  }

  else {
    Serial.print("Unknown command: ");
    Serial.println(cmd);
  }
}

// ==========================================================
// SERVO SMOOTH MOVEMENT
// ==========================================================
void updateServo() {
  if (servoCurrent == servoTarget) return;

  if (servoCurrent < servoTarget) {
    servoCurrent += servoSpeed;
    if (servoCurrent > servoTarget) servoCurrent = servoTarget;
  } else {
    servoCurrent -= servoSpeed;
    if (servoCurrent < servoTarget) servoCurrent = servoTarget;
  }

  cameraServo.write(servoCurrent);
}

// ==========================================================
// HOMING FUNCTION
// ==========================================================
void homeStepper() {
  Serial.println("Homing stepper motor...");

  stepper.setSpeed(500);

  while (digitalRead(homeSwitchPin) == HIGH) {
    stepper.runSpeed();
  }

  stepper.stop();
  delay(100);

  stepper.setCurrentPosition(0);
  isHomed = true;

  Serial.println("Homing complete.");
  printCurrentPosition();
}

// ==========================================================
// DESCEND FUNCTION
// ==========================================================
void descendStepper() {
  Serial.println("Descending...");

  stepper.moveTo(-600);
  while (stepper.distanceToGo() != 0) stepper.run();

  delay(500);

  stepper.moveTo(equilibriumPosition);
  while (stepper.distanceToGo() != 0) stepper.run();

  Serial.println("Descend complete.");
  printCurrentPosition();
}

// ==========================================================
// ASCEND FUNCTION
// ==========================================================
void ascendStepper() {
  Serial.println("Ascending...");

  stepper.moveTo(0);
  while (stepper.distanceToGo() != 0) stepper.run();

  delay(500);

  stepper.moveTo(equilibriumPosition);
  while (stepper.distanceToGo() != 0) stepper.run();

  Serial.println("Ascend complete.");
  printCurrentPosition();
}

// ==========================================================
// STOP AFTER DESCEND
// ==========================================================
void stopAfterDescend() {
  Serial.println("Stop after descend...");

  stepper.moveTo(100);
  while (stepper.distanceToGo() != 0) stepper.run();

  delay(500);

  stepper.moveTo(equilibriumPosition);
  while (stepper.distanceToGo() != 0) stepper.run();

  Serial.println("Stop after descend complete.");
  printCurrentPosition();
}

// ==========================================================
// TEMPERATURE READ
// ==========================================================
void readAndPrintTemperature() {
  sensors.requestTemperatures();
  float tempC = sensors.getTempCByIndex(0);

  if (tempC == DEVICE_DISCONNECTED_C) {
    Serial.println("Temp sensor error: device disconnected.");
    return;
  }

  float tempF = (tempC * 9.0) / 5.0 + 32.0;

  Serial.print("Temperature: ");
  Serial.print(tempC, 2);
  Serial.print(" °C  |  ");
  Serial.print(tempF, 2);
  Serial.println(" °F");
}
